# Copy to /etc/whisper-vm/whisper.env on the PBX (install.sh does this for you).
# Both vm-transcribe.sh and vm-mailcmd.py read this file.

# ---- backend selection ----
# local = run whisper.cpp binary on this host
# http  = POST audio to a whisper.cpp server (the Docker container)
WHISPER_BACKEND=local

# ---- local backend ----
WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/opt/whisper.cpp/models/ggml-base.en.bin

# ---- http backend (Docker container from docker/docker-compose.yml) ----
# WHISPER_BACKEND=http
WHISPER_URL=http://127.0.0.1:8088/inference

# ---- common ----
WHISPER_LANG=en
# WHISPER_THREADS=4          # defaults to CPU core count

# ---- mailcmd wrapper (vm-mailcmd.py) ----
TRANSCRIBE_SCRIPT=/opt/whisper-vm/vm-transcribe.sh
TRANSCRIBE_TIMEOUT=120
SENDMAIL_BIN=/usr/sbin/sendmail -t
TRANSCRIBE_LOG=/var/log/asterisk/vm-transcribe.log
